{
  "name": "JEUROBLOX",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$className": "Folder",
        "GameConfig": {
          "$className": "ModuleScript",
          "$path": "src/shared/GameConfig.lua"
        }
      }
    },

    "ServerScriptService": {
      "GameServer": {
        "$className": "Script",
        "$path": "src/server/init.server.lua"
      },
      "WorldBuilder": {
        "$className": "ModuleScript",
        "$path": "src/server/WorldBuilder.lua"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$className": "LocalScript",
          "$path": "src/client/init.client.lua"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },

    "Lighting": {
      "$properties": {
        "Brightness": 2,
        "GlobalShadows": true,
        "Technology": "Voxel"
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
